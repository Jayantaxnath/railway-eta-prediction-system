# ─────────────────────────────────────────────────────────────
# RailX — Environment Variables Template
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── RailRadar API (Live train positions) ──────────────────────
# Get your key at: https://railradar.in
RAILWAY_API_KEY=your_railradar_api_key_here

# ── OpenWeatherMap API (Rainfall data) ────────────────────────
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=sih
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Service URLs (defaults work for local Docker Compose) ─────
ML_API_URL=http://localhost:8000
ML_API_TIMEOUT=10000
# Leave empty: the frontend calls /api on its own origin and Vite proxies it.
# Only set this if the backend is on a different host than the frontend.
VITE_API_BASE_URL=

# ── Train Ingestion Config ────────────────────────────────────
TRAIN_DATA_FETCH_INTERVAL=300000
ACTIVE_TRAIN_NUMBERS=12919,12920
